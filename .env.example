# Copy to apps/api/.env for running the API outside Docker.
DATABASE_URL=postgresql://walletshop:walletshop@localhost:5433/walletshop
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Required: any random string of 16+ chars. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# Stripe TEST mode only (live keys are rejected). Optional: without them the app runs but top-ups are disabled.
# STRIPE_SECRET_KEY: Stripe Dashboard (test mode) -> Developers -> API keys -> Secret key (sk_test_...)
# STRIPE_WEBHOOK_SECRET: printed by `stripe listen` (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
