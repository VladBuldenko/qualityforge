# Copy to apps/api/.env for running the API outside Docker.
DATABASE_URL=postgresql://walletshop:walletshop@localhost:5433/walletshop
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Required: any random string of 16+ chars. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
