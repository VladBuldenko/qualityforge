generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(CUSTOMER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cart               Cart?
  walletAccounts     WalletAccount[]
  walletTransactions WalletTransaction[]
  exchanges          Exchange[]
  topUps             TopUp[]
  orders             Order[]
}

// Session store table used by connect-pg-simple (layout must match its expectations).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

// DB-level CHECK constraints (price >= 0, stock >= 0, PHYSICAL requires stock) live in the migration SQL.
model Product {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  slug          String      @unique
  description   String
  type          ProductType
  category      String
  priceCents    Int
  currency      String      @default("EUR")
  image         String
  stockQuantity Int? // null = unlimited (digital demo availability)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([isActive, type])
  @@index([category])
}

// One persistent cart per user. Prices are never stored here: they are read from Product at request time.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// CHECK (quantity between 1 and 20) lives in the migration SQL.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

enum Currency {
  EUR
  USD
}

enum AccountKind {
  USER // a customer's wallet in one currency
  CLEARING // internal counter-account: the other side of every credit/debit (balance is derived from entries)
}

enum TransactionType {
  CREDIT
  DEBIT
}

// Amounts are integer minor units (cents). CHECK constraints (balance >= 0 for USER accounts, etc.),
// the clearing-account uniqueness and the append-only triggers live in the migration SQL.
model WalletAccount {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency     Currency
  kind         AccountKind   @default(USER)
  balanceMinor Int           @default(0) // maintained for USER accounts only
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  entries      LedgerEntry[]

  @@unique([userId, currency])
}

// One row per financial operation. Append-only. operationId is the idempotency key.
model WalletTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  operationId    String          @unique
  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  type           TransactionType
  currency       Currency
  amountMinor    Int
  description    String?
  createdAt      DateTime        @default(now())
  entries        LedgerEntry[]
  topUp          TopUp?
  order          Order?
  exchangeDebit  Exchange?       @relation("ExchangeDebit")
  exchangeCredit Exchange?       @relation("ExchangeCredit")

  @@index([userId, createdAt])
}

// Double entry: every transaction has two entries (user account and clearing account) summing to zero. Append-only.
model LedgerEntry {
  id                String            @id @default(uuid()) @db.Uuid
  transactionId     String            @db.Uuid
  transaction       WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId         String            @db.Uuid
  account           WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountMinor       Int // signed: + increases the account, - decreases it
  balanceAfterMinor Int? // USER accounts only
  createdAt         DateTime          @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
}

enum PaymentProvider {
  STRIPE
}

enum TopUpStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// A wallet top-up paid through Stripe Checkout (TEST MODE only). Created PENDING before the customer is sent to Stripe;
// becomes SUCCEEDED only in the same DB transaction that records the wallet credit.
model TopUp {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider                PaymentProvider    @default(STRIPE)
  amountMinor             Int
  currency                Currency           @default(EUR)
  status                  TopUpStatus        @default(PENDING)
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?            @unique
  walletTransactionId     String?            @unique @db.Uuid
  walletTransaction       WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([userId, createdAt])
}

enum PaymentStatus {
  PAID
}

// CONFIRMED = paid, something still to be fulfilled; COMPLETED = every item fulfilled.
enum OrderStatus {
  CONFIRMED
  COMPLETED
}

// Digital items are DELIVERED as soon as the order is paid (demo entitlement issued).
// Physical items progress PROCESSING -> SHIPPED -> DELIVERED. This is a SIMULATION only (no carrier).
enum FulfillmentState {
  PROCESSING
  SHIPPED
  DELIVERED
}

// A paid order. Orders exist only after a successful wallet debit (created in the same DB transaction).
// CHECK constraints (totals, shipping all-or-none, EUR only) live in the migration SQL.
model Order {
  id                  String            @id @default(uuid()) @db.Uuid
  reference           String            @unique // customer-facing, e.g. WS-7K2M9Q4X
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency            Currency          @default(EUR)
  totalCents          Int
  paymentStatus       PaymentStatus     @default(PAID)
  status              OrderStatus       @default(CONFIRMED)
  idempotencyKey      String
  requestHash         String // hash of the checkout request details; a reused key with different details is rejected
  walletTransactionId String            @unique @db.Uuid
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  shippingName        String?
  shippingLine1       String?
  shippingLine2       String?
  shippingCity        String?
  shippingPostalCode  String?
  shippingCountry     String?
  createdAt           DateTime          @default(now())
  items               OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

// Immutable snapshot of what was bought, at the price paid. Never re-read from Product for display.
model OrderItem {
  id               String               @id @default(uuid()) @db.Uuid
  orderId          String               @db.Uuid
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId        String               @db.Uuid
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName      String
  productType      ProductType
  quantity         Int
  unitPriceCents   Int
  lineTotalCents   Int
  currency         Currency             @default(EUR)
  fulfillmentState FulfillmentState
  createdAt        DateTime             @default(now())
  digital          DigitalFulfillment[]

  @@index([orderId])
  @@index([productId])
}

// Demo-only entitlement for a paid digital item (one per purchased unit). Not a real license.
model DigitalFulfillment {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  unitIndex   Int
  code        String    @unique
  issuedAt    DateTime  @default(now())

  @@unique([orderItemId, unitIndex])
}

// A completed EUR<->USD demo conversion: one wallet debit + one wallet credit, committed atomically.
// Immutable (trigger in the migration). Rate is stored exactly as executed: destination = floor(source * rateNumerator / rateDenominator).
// CHECK constraints (currencies differ, positive amounts, rate) live in the migration SQL.
model Exchange {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  user                User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey      String
  fromCurrency        Currency
  toCurrency          Currency
  fromAmountMinor     Int
  toAmountMinor       Int
  rateNumerator       Int
  rateDenominator     Int
  rateVersion         String
  debitTransactionId  String            @unique @db.Uuid
  debitTransaction    WalletTransaction @relation("ExchangeDebit", fields: [debitTransactionId], references: [id], onDelete: Restrict)
  creditTransactionId String            @unique @db.Uuid
  creditTransaction   WalletTransaction @relation("ExchangeCredit", fields: [creditTransactionId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}
