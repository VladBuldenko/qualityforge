generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         Cart?
}

// Session store table used by connect-pg-simple (layout must match its expectations).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

// DB-level CHECK constraints (price >= 0, stock >= 0, PHYSICAL requires stock) live in the migration SQL.
model Product {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  slug          String      @unique
  description   String
  type          ProductType
  category      String
  priceCents    Int
  currency      String      @default("EUR")
  image         String
  stockQuantity Int? // null = unlimited (digital demo availability)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cartItems     CartItem[]

  @@index([isActive, type])
  @@index([category])
}

// One persistent cart per user. Prices are never stored here: they are read from Product at request time.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// CHECK (quantity between 1 and 20) lives in the migration SQL.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}
