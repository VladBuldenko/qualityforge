generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(CUSTOMER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cart               Cart?
  walletAccounts     WalletAccount[]
  walletTransactions WalletTransaction[]
  topUps             TopUp[]
}

// Session store table used by connect-pg-simple (layout must match its expectations).
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

// DB-level CHECK constraints (price >= 0, stock >= 0, PHYSICAL requires stock) live in the migration SQL.
model Product {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  slug          String      @unique
  description   String
  type          ProductType
  category      String
  priceCents    Int
  currency      String      @default("EUR")
  image         String
  stockQuantity Int? // null = unlimited (digital demo availability)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  cartItems CartItem[]

  @@index([isActive, type])
  @@index([category])
}

// One persistent cart per user. Prices are never stored here: they are read from Product at request time.
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// CHECK (quantity between 1 and 20) lives in the migration SQL.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

enum Currency {
  EUR
  USD
}

enum AccountKind {
  USER // a customer's wallet in one currency
  CLEARING // internal counter-account: the other side of every credit/debit (balance is derived from entries)
}

enum TransactionType {
  CREDIT
  DEBIT
}

// Amounts are integer minor units (cents). CHECK constraints (balance >= 0 for USER accounts, etc.),
// the clearing-account uniqueness and the append-only triggers live in the migration SQL.
model WalletAccount {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  currency     Currency
  kind         AccountKind   @default(USER)
  balanceMinor Int           @default(0) // maintained for USER accounts only
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  entries      LedgerEntry[]

  @@unique([userId, currency])
}

// One row per financial operation. Append-only. operationId is the idempotency key.
model WalletTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  operationId String          @unique
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        TransactionType
  currency    Currency
  amountMinor Int
  description String?
  createdAt   DateTime        @default(now())
  entries     LedgerEntry[]
  topUp       TopUp?

  @@index([userId, createdAt])
}

// Double entry: every transaction has two entries (user account and clearing account) summing to zero. Append-only.
model LedgerEntry {
  id                String            @id @default(uuid()) @db.Uuid
  transactionId     String            @db.Uuid
  transaction       WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId         String            @db.Uuid
  account           WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountMinor       Int // signed: + increases the account, - decreases it
  balanceAfterMinor Int? // USER accounts only
  createdAt         DateTime          @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
}

enum PaymentProvider {
  STRIPE
}

enum TopUpStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// A wallet top-up paid through Stripe Checkout (TEST MODE only). Created PENDING before the customer is sent to Stripe;
// becomes SUCCEEDED only in the same DB transaction that records the wallet credit.
model TopUp {
  id                      String             @id @default(uuid()) @db.Uuid
  userId                  String             @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider                PaymentProvider    @default(STRIPE)
  amountMinor             Int
  currency                Currency           @default(EUR)
  status                  TopUpStatus        @default(PENDING)
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?            @unique
  walletTransactionId     String?            @unique @db.Uuid
  walletTransaction       WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([userId, createdAt])
}
